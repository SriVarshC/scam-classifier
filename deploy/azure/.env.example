# Copy to deploy/azure/.env on the VM (never commit the real .env).
# Public name of the VM, from Azure: <dns-label>.<region>.cloudapp.azure.com
DOMAIN=scamcheck-demo.eastus.cloudapp.azure.com
# Generate on the VM: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SCAM_SERVICE_TOKEN=
# LLM settings (defaults shown)
CALL_LLM_MODEL=qwen2.5:7b
SCAM_LLM_TIMEOUT_SECONDS=100
CALL_LLM_NUM_CTX=4096
CALL_LLM_NUM_PREDICT=350
# Leave empty to let Ollama use all cores; or set to the VM's vCPU count
CALL_LLM_NUM_THREAD=
